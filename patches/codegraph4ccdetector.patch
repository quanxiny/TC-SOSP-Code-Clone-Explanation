+    def forward_sparse(
+            self, h, edge_attr, edge_index,
+            attention_edge_attr=None, attention_edge_index=None):
+        """Equivalent edge-only implementation of the dense attention step."""
+        h = F.dropout(h, self.dropout, training=self.training)
+        Wh = torch.mm(h, self.W)
+        transformed_edges = torch.mm(edge_attr, self.W)
+        if attention_edge_attr is None:
+            attention_edge_attr = edge_attr
+            attention_edge_index = edge_index
+        transformed_attention_edges = torch.mm(attention_edge_attr, self.W)
+        sources = attention_edge_index[0]
+        targets = attention_edge_index[1]
+        combinations = torch.cat(
+            [Wh[sources], Wh[targets], transformed_attention_edges], dim=1
+        )
+        scores = self.leakyrelu(torch.matmul(combinations, self.a).squeeze(1))
+        attention = grouped_softmax(scores, sources, num_nodes=Wh.size(0))
+        attention = F.dropout(attention, self.dropout, training=self.training)
+        h_prime = scatter_add(
+            attention.unsqueeze(1) * Wh[targets],
+            sources,
+            dim=0,
+            dim_size=Wh.size(0),
+        )
+        if self.concat:
+            return F.elu(h_prime), F.elu(transformed_edges)
+        return h_prime, transformed_edges
