diff --git a/README.md b/README.md
index 47ddc66..cc90d57 100644
--- a/README.md
+++ b/README.md
@@ -11,3 +11,35 @@ Run createPDGCodeJson.java to batch generate PDG files and save their vectorized
 
 Note: LearnTest.java uses the corpus of CFG/PDG to train Word2Vec.
 
+Reproduction smoke test (JDK 8 is required by the Gradle 4.7 wrapper):
+
+    JAVA_HOME=../.conda/codegraph4cc \
+    PATH=../.conda/codegraph4cc/bin:$PATH \
+    ./gradlew preprocessingSmoke \
+      -Pinput=googlejam1.p006.A.java \
+      -Poutput=artifacts/preprocessing_smoke
+
+The task trains fresh 16-dimensional CFG and PDG Word2Vec models from the
+checked-in corpora, then generates CFG/PDG DOT files, token corpora, and both
+plain and vector JSON files below the selected output directory. The checked-in
+`cfg_model.bin` is 32-dimensional and therefore does not match the paper's
+16-dimensional setting; the smoke task intentionally does not use it.
+
+For a complete dataset, first train an explicitly dimensioned model and then
+run the auditable batch task. Batch failures are recorded in
+`preprocessing_report_cfg.json`; pass `-PfailurePolicy=strict` to fail the task
+after all files have been attempted.
+
+    JAVA_HOME=../.conda/codegraph4cc \
+    PATH=../.conda/codegraph4cc/bin:$PATH \
+    ./gradlew trainWord2Vec \
+      -PgraphType=cfg -Pdimension=16 \
+      -Pcorpus=outPut_cfg/corpus/cfg_corpus.txt \
+      -PoutputModel=artifacts/models/bcb_cfg_word2vec_16.bin
+
+    JAVA_HOME=../.conda/codegraph4cc \
+    PATH=../.conda/codegraph4cc/bin:$PATH \
+    ./gradlew preprocessDataset \
+      -PgraphType=cfg -Pinput=bigclonebenchdata \
+      -Pmodel=artifacts/models/bcb_cfg_word2vec_16.bin \
+      -Poutput=artifacts/bcb_cfg16_rebuilt -PfailurePolicy=record
diff --git a/build.gradle b/build.gradle
index b04f45a..23a8d5b 100644
--- a/build.gradle
+++ b/build.gradle
@@ -46,3 +46,68 @@ dependencies {
     //compile group: 'com.alibaba', name: 'fastjson', version: '1.2.47'
 }
 
+task preprocessingSmoke(type: JavaExec) {
+    description = 'Generate CFG/PDG DOT and vector JSON for one Java file.'
+    group = 'verification'
+    classpath = sourceSets.main.runtimeClasspath
+    main = 'yoshikihigo.tinypdg.graphviz.PreprocessingSmoke'
+
+    doFirst {
+        final String inputProperty = project.findProperty('input')
+        if (inputProperty == null) {
+            throw new GradleException('Pass the Java source with -Pinput=/path/to/File.java')
+        }
+
+        final File outputDirectory = file(
+                project.findProperty('output') ?: 'artifacts/preprocessing_smoke')
+        outputDirectory.mkdirs()
+        workingDir outputDirectory
+        args file(inputProperty).absolutePath,
+                file('outPut_cfg/corpus/cfg_corpus.txt').absolutePath,
+                file('outPut_pdg/corpus/pdg_corpus.txt').absolutePath
+    }
+}
+
+task preprocessDataset(type: JavaExec) {
+    description = 'Generate legacy CFG/PDG JSON for every Java file in a tree.'
+    group = 'data processing'
+    classpath = sourceSets.main.runtimeClasspath
+    main = 'yoshikihigo.tinypdg.graphviz.BatchPreprocess'
+
+    doFirst {
+        final String inputProperty = project.findProperty('input')
+        final String modelProperty = project.findProperty('model')
+        final String graphType = project.findProperty('graphType') ?: 'cfg'
+        if (inputProperty == null || modelProperty == null) {
+            throw new GradleException(
+                    'Pass -Pinput=/source/root and -Pmodel=/path/to/model.bin')
+        }
+
+        final File outputDirectory = file(
+                project.findProperty('output') ?: 'artifacts/dataset_preprocessing')
+        outputDirectory.mkdirs()
+        workingDir outputDirectory
+        args file(inputProperty).absolutePath, graphType, file(modelProperty).absolutePath
+        args project.findProperty('failurePolicy') ?: 'record'
+    }
+}
+
+task trainWord2Vec(type: JavaExec) {
+    description = 'Train a dimension-controlled Word2Vec model from a graph corpus.'
+    group = 'data processing'
+    classpath = sourceSets.main.runtimeClasspath
+    main = 'yoshikihigo.tinypdg.graphviz.LearnTest'
+
+    doFirst {
+        final String corpusProperty = project.findProperty('corpus')
+        final String outputProperty = project.findProperty('outputModel')
+        final String graphType = project.findProperty('graphType') ?: 'cfg'
+        final String dimension = project.findProperty('dimension') ?: '16'
+        if (corpusProperty == null || outputProperty == null) {
+            throw new GradleException(
+                    'Pass -Pcorpus=/path/to/corpus and -PoutputModel=/path/to/model.bin')
+        }
+        args graphType, dimension, file(corpusProperty).absolutePath,
+                file(outputProperty).absolutePath
+    }
+}
